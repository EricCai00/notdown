{
  "name": "notdown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vault,web \"tsx server/index.ts\" \"vite --host 127.0.0.1 --port 4317 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts"
  },
  "dependencies": {
