{
  "name": "notdown",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "main": "desktop-dist/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n vault,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 4317 --strictPort\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:build": "npm run desktop:runtime && tsc --noEmit && vite build --outDir desktop-dist/frontend && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis",
    "test:desktop": "npm run desktop:build && playwright test -c tests/e2e/desktop.config.ts",
    "mobile:dev": "vite --mode mobile --host 127.0.0.1 --port 4337 --strictPort",
    "mobile:build": "tsc --noEmit && vite build --mode mobile",
    "android:sync": "npm run mobile:build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "android:open": "cap open android",
    "test:mobile": "npm run mobile:build && playwright test -c tests/e2e/mobile.config.ts",
    "test:sync": "npm run build -- --outDir .run/sync-frontend && vite build --mode mobile --outDir ../../.run/sync-mobile-frontend && playwright test -c tests/e2e/sync.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3",
    "fflate": "0.8.2",
    "pathe": "2.0.3",
    "@alex.garcia/unofficial-observablehq-compiler": "^0.6.0-alpha.9",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@observablehq/inputs": "^0.12.0",
    "@observablehq/inspector": "^5.0.1",
    "@observablehq/plot": "^0.6.17",
    "@observablehq/runtime": "^6.0.0",
    "@observablehq/stdlib": "^5.8.8",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "codemirror": "^6.0.2",
    "commonmark": "0.31.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.3.0",
    "express": "^5.1.0",
    "katex": "^0.18.7",
    "lucide": "^0.577.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "^11.17.2",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "^8.0.1",
    "prismjs": "^1.30.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3",
    "yaml": "^2.8.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "concurrently": "^9.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
